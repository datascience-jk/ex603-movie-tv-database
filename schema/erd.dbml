Table users {
  user_id integer [pk]
  user_display_name varchar(50) [not null, unique]
  joined_at timestamp [not null, default: `now()`]
  last_active timestamp
  is_active bool [not null, default: true]
}

Table ratings {
  rating_id integer [pk]
  user_id integer [note: 'nullable; SET NULL on user delete']
  movie_id integer [not null]
  score smallint [not null, note: 'CHECK (score BETWEEN 0 AND 10)']
  posted_at timestamp [not null, default: `now()`]
}

Table movies {
  movie_id integer [pk]
  movie_title varchar(200) [not null]
  runtime_minutes integer [note: 'CHECK (runtime_minutes > 0)']
  release_date date
  is_active bool [not null, default: true]
}

Table movie_genres {
  movie_id integer [not null]
  genre_id integer [not null]

  indexes {
    (movie_id, genre_id) [pk]
  }
}

Table genres {
  genre_id integer [pk]
  genre_name varchar(50) [not null, unique]
}

Ref rates: ratings.user_id > users.user_id [delete: set null]

Ref receives: movies.movie_id < ratings.movie_id [delete: cascade]

Ref tagged: movies.movie_id < movie_genres.movie_id [delete: cascade]

Ref applied: genres.genre_id < movie_genres.genre_id [delete: cascade]
